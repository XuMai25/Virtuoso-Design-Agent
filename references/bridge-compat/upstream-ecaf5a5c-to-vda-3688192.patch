@@ -0,0 +1,247 @@
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from virtuoso_bridge.models import ExecutionStatus
+from virtuoso_bridge.virtuoso.basic import bridge as bridge_module
+from virtuoso_bridge.virtuoso.basic.bridge import VirtuosoClient
+
+
+class _FakeTunnel:
+    def __init__(self, *, port: int = 65433, warm_error: Exception | None = None):
+        self.port = port
+        self.warm_error = warm_error
+        self.warm_calls: list[int] = []
+
+    def warm(self, timeout: int = 15) -> None:
+        self.warm_calls.append(timeout)
+        if self.warm_error is not None:
+            raise self.warm_error
+
+
+def test_execute_skill_warms_once_after_pre_send_refusal(monkeypatch) -> None:
+    tunnel = _FakeTunnel()
+    client = VirtuosoClient(port=65432, tunnel=tunnel)
+    outcomes = iter(
+        [
+            bridge_module._PreSendConnectionRefused(10061, "refused"),
+            bridge_module._STX + "3",
+        ]
+    )
+    calls = 0
+
+    def execute_once(skill_code: str, timeout: float, deadline: float) -> str:
+        nonlocal calls
+        calls += 1
+        outcome = next(outcomes)
+        if isinstance(outcome, Exception):
+            raise outcome
+        return outcome
+
+    monkeypatch.setattr(client, "_execute_skill_once", execute_once)
+
+    result = client.execute_skill("1+2", timeout=30)
+
+    assert result.status == ExecutionStatus.SUCCESS
+    assert result.output == "3"
+    assert calls == 2
+    assert tunnel.warm_calls == [15]
+    assert client.port == 65433
+
+
+def test_execute_skill_does_not_warm_unmarked_connection_error(monkeypatch) -> None:
+    tunnel = _FakeTunnel()
+    client = VirtuosoClient(port=65432, tunnel=tunnel)
+    monkeypatch.setattr(
+        client,
+        "_execute_skill_once",
+        lambda skill_code, timeout, deadline: (_ for _ in ()).throw(
+            ConnectionRefusedError(10061, "after connect")
+        ),
+    )
+
+    result = client.execute_skill("sideEffect()", timeout=30)
+
+    assert result.status == ExecutionStatus.ERROR
+    assert tunnel.warm_calls == []
+
+
+@pytest.mark.parametrize("error", [ConnectionRefusedError(111, "after send"), ConnectionResetError(104, "after send")])
+def test_jump_host_never_replays_an_unmarked_post_send_failure(monkeypatch, error):
+    tunnel = _FakeTunnel()
+    client = VirtuosoClient(port=65432, tunnel=tunnel)
+    client._has_jump_host = True
+    calls = []
+
+    def uncertain(*args, **kwargs):
+        calls.append(1)
+        raise error
+
+    monkeypatch.setattr(client, "_execute_skill_once", uncertain)
+    result = client.execute_skill("sideEffect()", timeout=30)
+    assert result.status == ExecutionStatus.ERROR
+    assert calls == [1]
+    assert tunnel.warm_calls == []
+
+
+def test_execute_skill_attempts_pre_send_recovery_only_once(monkeypatch) -> None:
+    tunnel = _FakeTunnel()
+    client = VirtuosoClient(port=65432, tunnel=tunnel)
+    calls = 0
+
+    def refuse_once_per_call(skill_code: str, timeout: float, deadline: float) -> str:
+        nonlocal calls
+        calls += 1
+        raise bridge_module._PreSendConnectionRefused(10061, "refused")
+
+    monkeypatch.setattr(client, "_execute_skill_once", refuse_once_per_call)
+
+    result = client.execute_skill("1+2", timeout=30)
+
+    assert result.status == ExecutionStatus.ERROR
+    assert calls == 2
+    assert tunnel.warm_calls == [15]
+
+
+def test_execute_skill_reports_warm_failure_without_looping(monkeypatch) -> None:
+    tunnel = _FakeTunnel(warm_error=RuntimeError("cannot rebuild"))
+    client = VirtuosoClient(port=65432, tunnel=tunnel)
+    calls = 0
+
+    def refuse(skill_code: str, timeout: float, deadline: float) -> str:
+        nonlocal calls
+        calls += 1
+        raise bridge_module._PreSendConnectionRefused(10061, "refused")
+
+    monkeypatch.setattr(client, "_execute_skill_once", refuse)
+
+    result = client.execute_skill("1+2", timeout=30)
+
+    assert result.status == ExecutionStatus.ERROR
+    assert calls == 1
+    assert tunnel.warm_calls == [15]
+
+
+def test_execute_skill_once_marks_connect_refusal_before_send(monkeypatch) -> None:
+    class _RefusingSocket:
+        def __init__(self):
+            self.send_called = False
+
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *args):
+            return None
+
+        def settimeout(self, timeout: int) -> None:
+            pass
+
+        def connect(self, address) -> None:
+            raise ConnectionRefusedError(10061, "refused")
+
+        def sendall(self, payload: bytes) -> None:
+            self.send_called = True
+            raise AssertionError("payload must not be sent after refused connect")
+
+    fake_socket = _RefusingSocket()
+    monkeypatch.setattr(
+        bridge_module.socket,
+        "socket",
+        lambda *args, **kwargs: fake_socket,
+    )
+    client = VirtuosoClient(port=65432)
+
+    with pytest.raises(bridge_module._PreSendConnectionRefused):
+        client._execute_skill_once("sideEffect()", timeout=30, deadline=bridge_module.time.monotonic() + 30)
+
+    assert fake_socket.send_called is False
+
+
