+@dataclass(frozen=True)
+class DaemonBindCheck:
+    ok: bool
+    daemon_bind: str = ""
+    error: str = ""
+
+
+def query_daemon_bind(client: Any, *, timeout: int = 5) -> str:
+    result = client.execute_skill(
+        "if(boundp('RBLastBind) RBLastBind \"\")", timeout=timeout,
+    )
+    if result.status != ExecutionStatus.SUCCESS:
+        raise RuntimeError("; ".join(result.errors) or "daemon bind query failed")
+    return clean_skill_output(result.output)
+
+
+def check_daemon_bind(client: Any, *, timeout: int = 5) -> DaemonBindCheck:
+    daemon_bind = query_daemon_bind(client, timeout=timeout)
+    if not daemon_bind:
+        return DaemonBindCheck(False, error="daemon did not report its actual bind address")
+    try:
+        host, separator, port = daemon_bind.rpartition(":")
+        if not separator or not port.isascii() or not port.isdigit() or not 1 <= int(port) <= 65535:
+            raise ValueError("invalid bind port")
+        host = host.strip("[]")
+        loopback = ipaddress.ip_address(host).is_loopback
+    except ValueError:
+        loopback = False
+    if not loopback:
+        return DaemonBindCheck(
+            False, daemon_bind,
+            f"daemon is not bound to loopback: {daemon_bind}",
+        )
+    return DaemonBindCheck(True, daemon_bind)
+
+
