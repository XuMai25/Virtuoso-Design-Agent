diff --git a/tests/test_ssh_retry.py b/tests/test_ssh_retry.py
new file mode 100644
index 0000000000000000000000000000000000000000..78bf1e96cc7e542b07fa10d50fb878ee9caa4027
--- /dev/null
+++ b/tests/test_ssh_retry.py
@@ -0,0 +1,120 @@
+from __future__ import annotations
+
+from virtuoso_bridge.transport import ssh as ssh_module
+from virtuoso_bridge.transport.ssh import SSHRunner
+
+
+def _runner(monkeypatch) -> SSHRunner:
+    monkeypatch.setattr(ssh_module, "load_vb_env", lambda: None)
+    monkeypatch.setattr(ssh_module, "_setup_command_log", lambda: None)
+    monkeypatch.delenv("VB_DISABLE_CONTROL_MASTER", raising=False)
+    monkeypatch.delenv("VB_FORCE_CONTROL_MASTER", raising=False)
+    return SSHRunner(host="example.invalid")
+
+
+def _attempt_with_budget(runner: SSHRunner, run_one):
+    return runner._attempt_with_cm_fallback(
+        run_one,
+        budget=ssh_module._TimeoutBudget.start(10, 10),
+        command="test",
+    )
+
+
+def test_idempotent_transport_retries_use_bounded_backoff(monkeypatch) -> None:
+    runner = _runner(monkeypatch)
+    sleeps: list[float] = []
+    monkeypatch.setattr(ssh_module.time, "sleep", sleeps.append)
+    outcomes = iter(
+        [
+            (255, b"", b"Connection closed by UNKNOWN port 65535"),
+            (255, b"", b"ssh: connect to host design port 22: Connection timed out"),
+            (0, b"ok", b""),
+        ]
+    )
+    calls = 0
+
+    def run_one():
+        nonlocal calls
+        calls += 1
+        return next(outcomes)
+
+    result = _attempt_with_budget(runner, run_one)
+
+    assert result == (0, b"ok", b"")
+    assert calls == 3
+    assert sleeps == [1.0, 3.0]
+    assert runner._use_control_master is True
+
+
+def test_controlmaster_failure_disables_mux_without_backoff(monkeypatch) -> None:
+    runner = _runner(monkeypatch)
+    sleeps: list[float] = []
+    monkeypatch.setattr(ssh_module.time, "sleep", sleeps.append)
+    outcomes = iter(
+        [
+            (255, b"", b"mux_client_request_session: session request failed"),
+            (0, b"ok", b""),
+        ]
+    )
+
+    result = _attempt_with_budget(runner, lambda: next(outcomes))
+
+    assert result == (0, b"ok", b"")
+    assert runner._use_control_master is False
+    assert sleeps == []
+
+
+def test_non_transient_transport_failure_is_not_retried(monkeypatch) -> None:
+    runner = _runner(monkeypatch)
+    sleeps: list[float] = []
+    monkeypatch.setattr(ssh_module.time, "sleep", sleeps.append)
+    calls = 0
+
+    def run_one():
+        nonlocal calls
+        calls += 1
+        return 255, b"", b"Permission denied (publickey)"
+
+    result = _attempt_with_budget(runner, run_one)
+
+    assert result == (255, b"", b"Permission denied (publickey)")
+    assert calls == 1
+    assert sleeps == []
+
+
+def test_remote_command_reuses_bounded_backoff(monkeypatch) -> None:
+    runner = _runner(monkeypatch)
+    sleeps: list[float] = []
+    monkeypatch.setattr(ssh_module.time, "sleep", sleeps.append)
+    monkeypatch.setattr(ssh_module, "_windows_no_window_kwargs", lambda **kwargs: {})
+    outcomes = iter(
+        [
+            ssh_module.subprocess.CompletedProcess(
+                args=[],
+                returncode=255,
+                stdout=b"",
+                stderr=b"Connection reset by peer",
+            ),
+            ssh_module.subprocess.CompletedProcess(
+                args=[],
+                returncode=0,
+                stdout=b"done",
+                stderr=b"",
+            ),
+        ]
+    )
+    calls = 0
+
+    def fake_run(*args, **kwargs):
+        nonlocal calls
+        calls += 1
+        return next(outcomes)
+
+    monkeypatch.setattr(ssh_module.subprocess, "run", fake_run)
+
+    result = runner._run_command_once("true", timeout=10)
+
+    assert result.returncode == 0
+    assert result.stdout == "done"
+    assert calls == 2
+    assert sleeps == [1.0]
