+from types import SimpleNamespace
+
+import pytest
+
+from virtuoso_bridge.daemon_guard import check_daemon_bind
+from virtuoso_bridge.models import ExecutionStatus, VirtuosoResult
+from virtuoso_bridge.transport import tunnel
+
+
+@pytest.mark.parametrize("address,ok", [
+    ("127.0.0.1:65432", True), ("[::1]:65432", True),
+    ("0.0.0.0:65432", False), ("", False), ("bad:65432", False),
+    ("127.0.0.1", False), ("127.0.0.1:bad", False),
+    ("127.0.0.1:0", False), ("127.0.0.1:65536", False),
+])
+def test_actual_bind_guard_remains_fail_closed(address, ok):
+    client = SimpleNamespace(execute_skill=lambda *args, **kwargs: VirtuosoResult(
+        status=ExecutionStatus.SUCCESS, output=address,
+    ))
+    assert check_daemon_bind(client).ok is ok
+
+
+def test_remote_token_override_provisions_only_the_selected_workspace(monkeypatch):
+    from tests.test_daemon_auth import _FakeRunner
+
+    monkeypatch.setattr(tunnel, "load_vb_env", lambda: None)
+    monkeypatch.setattr("virtuoso_bridge.transport.ssh.load_vb_env", lambda: None)
+    selected = "/data/designer/work/.auth/bridge_token"
+    monkeypatch.setenv("VB_REMOTE_TOKEN_PATH", selected)
+    client = tunnel.SSHClient(remote_host="example.invalid", remote_user="designer", port=65001)
+    runner = _FakeRunner()
+    client._ssh_runner = runner
+    assert client.ensure_daemon_token() is not None
+    assert not any("$HOME" in command or "~/" in command for command in runner.commands)
+    assert all(path.startswith(selected + ".tmp.") for _, path in runner.uploads)
+    assert "chmod 600" in runner.commands[-1]
+    setup = tunnel._generate_virtuoso_setup_il("/data/work/daemon.py", "/data/work/bridge.il", token_path=selected)
+    assert f'setShellEnvVar("RB_TOKEN_PATH" "{selected}")' in setup
+
+
+@pytest.mark.parametrize("path", ["relative/token", "/data/../token", "/token", '/data/unsafe"/token', "/data/unsafe\n/token"])
+def test_remote_token_override_rejects_unsafe_paths(monkeypatch, path):
+    monkeypatch.setenv("VB_REMOTE_TOKEN_PATH", path)
+    with pytest.raises(ValueError, match="absolute file"):
+        tunnel._remote_token_override(None)
+
+
+@pytest.mark.parametrize("corrupt", [False, True])
+@pytest.mark.parametrize("api", ["client", "standalone"])
+def test_signed_fragmented_reply_needs_no_eof_but_rejects_tampering(monkeypatch, corrupt, api):
+    import json
+    import os
+    from virtuoso_bridge import daemon_auth, VirtuosoClient
+    from virtuoso_bridge.virtuoso.basic import bridge
+
+    token = "ab" * 32
+    requests = []
+
+    class WireSocket:
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *args):
+            pass
+
+        def close(self):
+            pass
+
+        def settimeout(self, timeout):
+            pass
+
+        def connect(self, endpoint):
+            pass
+
+        def shutdown(self, mode):
+            raise AssertionError("Windows direct clients must not half-close")
+
+        def sendall(self, data):
+            request = json.loads(data)
+            requests.append(request)
+            hello = request.get("op") == "hello"
+            body = json.dumps({"proto": 1, "auth": "on", "virtuoso_pid": 1234}) if hello else "宽度+1"
+            raw = ("\x02" + daemon_auth.response_mac(
+                token, nonce=request["nonce"], marker="\x02", body=body,
+            ) + body).encode("utf-8")
+            self.corrupted = corrupt and not hello
+            if self.corrupted:
+                raw = raw[:-1] + b"0"
+            self.parts = [raw[:68], raw[68:]]
+
+        def recv(self, size):
+            if self.parts:
+                return self.parts.pop(0)
+            if self.corrupted:
+                return b""
+            raise AssertionError("complete authenticated reply must not wait for EOF")
+
+    monkeypatch.setattr(bridge.socket, "socket", lambda *args: WireSocket())
+    monkeypatch.setattr(bridge, "os", SimpleNamespace(name="nt", getenv=os.getenv))
+    if api == "client":
+        client = VirtuosoClient(daemon_token=token)
+        result = client.execute_skill("1+2", timeout=5)
+        assert result.status == (ExecutionStatus.ERROR if corrupt else ExecutionStatus.SUCCESS)
+        output = result.output
+    else:
+        import importlib.util
+        from pathlib import Path
+        spec = importlib.util.spec_from_file_location("vda_skill_exec", Path(__file__).parents[1] / "tools/skill_exec.py")
+        tool = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(tool)
+        monkeypatch.setattr(tool, "os", SimpleNamespace(name="nt", urandom=os.urandom))
+        output, error = tool.execute("1+2", timeout=5, token=token)
+        assert (error is not None) is corrupt
+    assert len(requests) == 2
+    if not corrupt:
+        assert output == "宽度+1"
