diff --git a/tests/test_daemon_request_framing.py b/tests/test_daemon_request_framing.py
new file mode 100644
index 0000000000000000000000000000000000000000..34c156042f79bb6c111d89fd9bf3f0bb74da0af5
--- /dev/null
+++ b/tests/test_daemon_request_framing.py
@@ -0,0 +1,76 @@
+from __future__ import annotations
+
+import ast
+import json
+import socket
+import time
+from pathlib import Path
+
+import pytest
+
+
+_RESOURCES = (
+    "ramic_bridge_daemon_3.py",
+    "ramic_bridge_daemon_27.py",
+)
+
+
+class _ChunkedConnection:
+    def __init__(self, chunks: list[bytes]):
+        self._chunks = list(chunks)
+
+    def settimeout(self, timeout):
+        assert timeout > 0
+
+    def recv(self, size: int) -> bytes:
+        if not self._chunks:
+            raise AssertionError("parser waited for EOF after complete JSON")
+        return self._chunks.pop(0)
+
+
+def _load_receive_json_request(resource_name: str):
+    path = (
+        Path(__file__).parents[1]
+        / "src"
+        / "virtuoso_bridge"
+        / "virtuoso"
+        / "basic"
+        / "resources"
+        / resource_name
+    )
+    tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
+    function = next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.FunctionDef) and node.name == "_recv_request"
+    )
+    module = ast.fix_missing_locations(ast.Module(body=[function], type_ignores=[]))
+    namespace = {"json": json, "socket": socket, "time": time,
+                 "_CONNECTION_TIMEOUT": 30, "_MAX_REQUEST_BYTES": 8 * 1024 * 1024}
+    exec(compile(module, str(path), "exec"), namespace)
+    return lambda conn: json.loads(namespace["_recv_request"](conn).decode("utf-8"))
+
+
+@pytest.mark.parametrize("resource_name", _RESOURCES)
+def test_daemon_parses_fragmented_json_without_waiting_for_eof(resource_name: str) -> None:
+    receive_json_request = _load_receive_json_request(resource_name)
+    payload = json.dumps(
+        {"skill": "宽度+1", "timeout": 30},
+        ensure_ascii=False,
+    ).encode("utf-8")
+    split = payload.index("宽".encode("utf-8")) + 1
+    connection = _ChunkedConnection([payload[:split], payload[split:]])
+
+    assert receive_json_request(connection) == {
+        "skill": "宽度+1",
+        "timeout": 30,
+    }
+
+
+@pytest.mark.parametrize("resource_name", _RESOURCES)
+def test_daemon_reports_malformed_json_after_legacy_eof(resource_name: str) -> None:
+    receive_json_request = _load_receive_json_request(resource_name)
+    connection = _ChunkedConnection([b'{"skill":', b""])
+
+    with pytest.raises((UnicodeDecodeError, ValueError)):
+        receive_json_request(connection)
