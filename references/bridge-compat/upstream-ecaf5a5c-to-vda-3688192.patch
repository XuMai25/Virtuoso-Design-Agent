@@ -0,0 +1,68 @@
+from __future__ import annotations
+
+from virtuoso_bridge.transport import ssh as ssh_module
+from virtuoso_bridge.transport import tunnel as tunnel_module
+from virtuoso_bridge.transport.ssh import SSHRunner
+from virtuoso_bridge.transport.tunnel import SSHClient
+
+
+def test_is_running_treats_unreachable_windows_port_as_stale(monkeypatch) -> None:
+    monkeypatch.setattr(
+        SSHClient,
+        "read_state",
+        classmethod(
+            lambda cls, profile=None: {
+                "mode": "remote",
+                "port": 65347,
+                "tunnel_pid": 987654,
+            }
+        ),
+    )
+
+    def refuse_connection(*args, **kwargs):
+        raise ConnectionRefusedError
+
+    def unexpected_pid_probe(*args, **kwargs):
+        raise AssertionError("Windows stale-state detection must not probe the PID")
+
+    monkeypatch.setattr(tunnel_module.socket, "create_connection", refuse_connection)
+    monkeypatch.setattr(tunnel_module, "_pid_is_alive", lambda pid: False)
+    monkeypatch.setattr(tunnel_module.os, "name", "nt")
+    monkeypatch.setattr(tunnel_module.os, "kill", unexpected_pid_probe)
+
+    assert SSHClient.is_running("nics4304_tsmc28") is False
+
+
+def test_is_running_handles_system_error_from_posix_pid_probe(monkeypatch) -> None:
+    monkeypatch.setattr(
+        SSHClient,
+        "read_state",
+        classmethod(lambda cls, profile=None: {"tunnel_pid": 987654}),
+    )
+
+    # Restore the process-wide ``os.name`` before fixture finalizers use
+    # pathlib; monkeypatching it for the whole test breaks WindowsPath.
+    with monkeypatch.context() as patch:
+        patch.setattr(tunnel_module.os, "name", "posix")
+        patch.setattr(
+            tunnel_module.os,
+            "kill",
+            lambda *args, **kwargs: (_ for _ in ()).throw(SystemError("stale PID")),
+        )
+        assert SSHClient.is_running() is False
+
+
+def test_ssh_runner_pid_helpers_handle_system_error(monkeypatch) -> None:
+    runner = SSHRunner(host="example.invalid")
+    runner._use_control_master = False
+    runner.tunnel_pid = 987654
+    runner._tunnel_using_external = True
+    monkeypatch.setattr(
+        ssh_module.os,
+        "kill",
+        lambda *args, **kwargs: (_ for _ in ()).throw(SystemError("stale PID")),
+    )
+
+    assert runner.is_tunnel_alive is False
+    runner.stop_port_forward()
+    assert runner.tunnel_pid is None
